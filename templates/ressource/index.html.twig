{% extends 'layout.html.twig' %}

{% block title %}{{ 'Ressources' | trans }} !{% endblock %}


{% block page_contents %}
{% if breadcrumb is defined %}
{% include 'partial/breadcrumb.html.twig' with { breadcrumb } %}
{% endif %}

<div id="resources" class="container">
    <h1>{{ "Toutes les <span class=\"text-secondary\">resources</span>" | trans | raw }}</h1>
    <section class="my-2 container">
        <div class="mb-3">
            <input type="text" id="searchInput" class="form-control" placeholder="{{ 'Rechercher' | trans }}">
        </div>
        <script>
            function filterResources() {
                const searchInput = document.getElementById('searchInput');
                const resourceItems = document.querySelectorAll('.parti-item');
                const searchTerm = searchInput.value.toLowerCase();

                resourceItems.forEach(item => {
                    const resourceName = item.querySelector('a').textContent.toLowerCase();
                    if (resourceName.includes(searchTerm)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }

            document.getElementById('searchInput').addEventListener('keyup', filterResources);
        </script>
        <div class="d-flex flex-wrap justify-content-between">
            {% for resource in resources %}
            <div class="resource-item {{ resource.isProgram ?'program' : 'status' }}">
                <a class="pdf-link" href="{{ asset('img/resource/'~resource.file) }}">
                    <img src="{{ asset('img/download.svg') }}" alt="icon-download" class="icon-download">
                    {{ resource.name }}
                </a>
            </div>
            {% endfor %}
        </div>
    </section>
</div>

<!-- Modale PDF Viewer -->
<div class="modal fade" id="pdfModal" tabindex="-1" aria-labelledby="pdfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfModalLabel">{{'Aperçu' | trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <iframe id="pdfIframe" src="" style="width:100%; height:500px;" frameborder="0"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{
                    'Fermer' | trans }}</button>
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}