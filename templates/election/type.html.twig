{% extends 'layout.html.twig' %}

{% block title %}
  {{ typeElection.name }}
{% endblock %}

{% block page_contents %}
  {% if breadcrumb is defined %}
    {% include 'partial/breadcrumb.html.twig' with {
      breadcrumb: breadcrumb
    } %}
  {% endif %}
  <div id="election">
    <section class="my-2 container">
      <div class="row">
        <div class="col-lg-7">
          <h1>{{ typeElection.title }}</h1>
          <p>{{ typeElection.description|raw }}</p>
          <div class="text-center mt-5 p-5 text-light search-election">
            <img src="{{ asset('img/homepage/search_icon.svg') }}" alt="search icon" />
            <h3 class="my-2">{{ 'Chercher une élection législative par date :'|trans }}</h3>
            <select id="selectElection" class="form-select filterSelect election-search"></select>
            <span hidden id="placeholderSelectElection">
              {{ 'Cherchez ici la date d’une élection (exemple : 1990, 1996…)'|trans }}
            </span>
          </div>
        </div>
        <div class="col-lg-5 d-flex align-self-center">
          <img src="{{ asset(image_path) }}" class="w-100 illustration" alt="" />
        </div>
      </div>
    </section>

    <section class="container-fluid bg-midnight-blue py-5">
      <div class="container">
        <h2 class="mb-4 text-start">Prochaines élections du {{ typeElection.name|trans|raw }} de 2024 en Belgique</h2>
        <p>
          Exsistit autem hoc loco quaedam quaestio subdifficilis, num quando amici novi, digni amicitia, veteribus sint
          anteponendi, ut equis vetulis teneros anteponere solemus. Indigna homine dubitatio! Non enim debent esse
          amicitiarum sicut aliarum rerum satietates; veterrima quaeque, ut ea vina, quae vetustatem ferunt. Exsistit
          autem hoc loco quaedam quaestio subdifficilis...
        </p>
      </div>
    </section>

    <section class="history container-fluid bg-light py-5">
      <h2 class="mb-4 ps-4 text-center">{{ "L'historique des élections législatives en Belgique"|trans }}</h2>
      <table class="table table-striped text-center">
        <tbody id="election-rows">
          {% for election in all_elections_date %}
            <tr class="election-row {{ loop.index > 5 ? 'd-none' : '' }}" data-index="{{ loop.index }}">
              <td class="left">Élections du {{ typeElection.name|trans|raw }} de {{ election.date|date('Y') }}</td>
              <td class="right">
                <a
                  href="{{
                  path(
                    'electionDate',
                    {
                      slug: election.slug,
                      year: election.date|date('Y')
                    }
                  )
                  }}"
                  class="btn btn-secondary btn-sm"
                  --
                >
                  {{ "Plus d'infos sur cette élection"|trans }}
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="text-center">
        <button
          id="show-more"
          class="btn btn-secondary"
          data-show-more="{{ 'Afficher plus'|trans }}"
          data-show-less="{{ 'Afficher moins'|trans }}"
        >
          {{ 'Afficher plus'|trans }}
        </button>
      </div>
    </section>

    <section class="election-infos py-5">
      <div class="container">
        <div class="card bg-blur p-4">
          <h2>{{ 'Tout savoir sur...'|trans }}</h2>
          <p>
            Exsistit autem hoc loco quaedam quaestio subdifficilis, num quando amici novi, digni amicitia, veteribus
