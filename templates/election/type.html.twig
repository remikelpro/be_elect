{% extends 'layout.html.twig' %}

{% block title %}
  {{ typeElection.name }}
{% endblock %}

{% block page_contents %}
  {% if breadcrumb is defined %}
    {% include 'partial/breadcrumb.html.twig' with {
      breadcrumb: breadcrumb
    } %}
  {% endif %}
  <div id="election">
    <section class="my-2 container py-4">
      <div class="row">
        <div class="col-lg-7">
          <h1>{{ ('election.main_title_' ~ typeElection.id)|trans }}</h1>

          <p>{{ typeElection.description|raw }}</p>
          <div class="text-center mt-5 p-5 text-light search-module">
            <img src="{{ asset('img/homepage/search_icon.svg') }}" alt="{{ 'icone loupe'|trans }}" class="mb-3" />
            <h3 class="mb-4">{{ ('election.search_by_date_' ~ typeElection.id)|trans }}</h3>

            <select
              id="selectElection"
              class="form-select filterSelect election-search"
              data-type-id="{{ typeElection.id }}"
            ></select>
            <span hidden id="placeholderSelectElection">{{ 'Ex : 1990, 1996...'|trans }}</span>
          </div>
        </div>
        <div class="col-lg-5 d-flex align-self-center">
          <img src="{{ asset(image_path.src) }}" class="w-100 illustration" alt="{{ image_path.alt|trans }}" />
        </div>
      </div>
    </section>

    <section class="container-fluid bg-midnight-blue py-4">
      <div class="container">
        {# <h2 class="mb-4 text-start">Prochaines élections du {{ typeElection.name|trans|raw }} de 2024 en Belgique</h2> #}
        {{ typeElection.nextElections|raw }}
      </div>
    </section>

    <section class="history container-fluid bg-light py-4">
      <h2 class="mb-4 ps-4 text-center">{{ ('election.history_' ~ typeElection.id)|trans }}</h2>
      <table class="table table-striped text-center">
        <tbody id="election-visible">
          {% for election in all_elections_date %}
            {% if loop.index <= 5 %}
              <tr class="election-row" data-index="{{ loop.index }}">
                <td class="left p-3 text-start text-md-center">
                  {{
                    ('election.table_title_' ~ typeElection.id)|trans({
                      year: election.date|date('Y')
                    })
                  }}
                </td>

                <td class="right p-3">
                  <a
                    href="{{
                    path(
                      'electionDate',
                      {
                        slug: election.slug
                      }
                    )
                    }}"
                    class="btn btn-secondary btn-sm"
                  >
                    {{ "Plus d'infos sur cette élection"|trans }}
                  </a>
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>

      <div id="election-more" class="collapse">
        <table class="table table-striped text-center">
          <tbody>
            <tr class="d-none"></tr>
            {% for election in all_elections_date|slice(5) %}
              <tr class="election-row" data-index="{{ loop.index + 5 }}">
                <td class="left p-3 text-start text-md-center">
                  {{
                    ('election.table_title_' ~ typeElection.id)|trans({
                      year: election.date|date('Y')
                    })
                  }}
                </td>
                <td class="right p-3">
                  <a
                    href="{{
                    path(
                      'electionDate',
                      {
                        slug: election.slug
                      }
                    )
                    }}"
                    class="btn btn-secondary btn-sm"
                  >
                    {{ "Plus d'infos sur cette élection"|trans }}
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if (all_elections_date|length) > 5 %}
        <div class="text-center">
          <button
            class="btn btn-outline-primary"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#election-more"
            aria-expanded="false"
            data-show-more="{{ 'Afficher plus'|trans }}"
            data-show-less="{{ 'Afficher moins'|trans }}"
            id="btn-show-more"
          >
            {{ 'Afficher plus'|trans }}
          </button>
        </div>
      {% endif %}
    </section>

    <section class="election-infos {{ typeElection.getCssClass }} py-4">
      <div class="container"><div class="card bg-blur p-4">{{ typeElection.allAbout|raw }}</div></div>
    </section>

    {% set i = 0 %}
    <section class="split-layout py-4">
      <h2 class="my-5 text-center">{{ 'Les autres élections en Belgique'|trans }}</h2>
      {% for election in all_elections_type %}
        {% if election.name != typeElection.name %}
          {% set i = i + 1 %}
          {% include 'election/_all-elections.html.twig' with {
            election: election,
            is_odd: i is odd
          } %}
        {% endif %}
      {% endfor %}
    </section>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('election') }}
{% endblock %}
