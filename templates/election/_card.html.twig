<article class="election-card-wrapper">
  <div class="election-card-shadow"></div>
  <div class="election-card text-center h-100">
    {# <h3 class="label-date">{{ election.date|date('F Y') }}</h3> #}
    <h3 class="label-date">{{ election.date|format_datetime(locale = app.request.locale, pattern = 'MMMM yyyy') }}</h3>

    <h4 class="mt-5">{{ election.name }}</h4>
    <div class="icon mb-2 p-4">
      <img src="{{ asset('img/election/' ~ election.idTypeElection.logo) }}" class="img-fluid object-fit-contain" />
    </div>
    <p>{{ 'Remporté par le'|trans }} {{ election.winner }}</p>
    {# prettier-ignore-start #}
    <a href="{{ path('electionDate', { slug: election.slug, year: election.date|date('Y') }) }}" class="btn btn-sm btn-secondary">
      {{'En savoir plus'|trans}}
    </a>
    {# prettier-ignore-end #}
  </div>
</article>
