{% extends 'layout.html.twig' %}

{% block title %}
  Be Elect - {{ 'Les résultats des élections en Belgique'|trans }}
{% endblock %}

{% block page_contents %}
  {% if breadcrumb is defined %}
    {% include 'partial/breadcrumb.html.twig' with {
      breadcrumb: breadcrumb
    } %}
  {% endif %}

  <div id="elections">
    <section class="my-2 container">
      <div class="row">
        <div class="col-lg-7">
          <h1>{{ 'Les <span class="text-secondary">résultats</span> des élections en Belgique'|trans|raw }}</h1>
          <p>
            Exsistit autem hoc loco quaedam quaestio subdifficilis, num quando amici novi, digni amicitia, veteribus
            sint anteponendi, ut equis vetulis teneros anteponere solemus. Indigna homine dubitatio!
          </p>

          {# module search #}
          <div class="text-center mt-5 p-5 text-light search-module">
            <img src="{{ asset('img/homepage/search_icon.svg') }}" alt="{{ 'icone loupe'|trans }}" class="mb-3" />
            <h3 class="mb-4">{{ 'Rechercher les résultats des élections'|trans }}</h3>
            <select id="selectElection" class="form-select filterSelect election-search"></select>
            <span hidden id="placeholderSelectElection">
              {{
                'Cherchez ici le nom ou la date d’une élection
                (exemple : 1990, Election fédérale, 1996...)'|trans
              }}
            </span>
          </div>
          {# module search #}
        </div>

        {# main illustration #}
        <div class="col-lg-5 d-flex align-self-center">
          <img
            src="{{ asset('img/elections/toutes-elections-illu-header.svg') }}"
            class="w-100 illustration"
            alt="{{ '
                  illustration de parlement'|trans }}"
          />
        </div>
        {# main illustration #}
      </div>
    </section>

    <section class="container-fluid bg-midnight-blue py-4 mt-5">
      <div class="container">
        <h2 class="mb-4 text-start">{{ 'Les prochaines élections en Belgique'|trans }}</h2>
        <p>
          Exsistit autem hoc loco quaedam quaestio subdifficilis, num quando amici novi, digni amicitia, veteribus sint
          anteponendi, ut equis vetulis teneros anteponere solemus. Indigna homine dubitatio! Non enim debent esse
          amicitiarum sicut aliarum rerum satietates; veterrima quaeque, ut ea vina, quae vetustatem ferunt. Exsistit
          autem hoc loco quaedam quaestio subdifficilis...
        </p>
      </div>
    </section>

    <section class="elections-grid py-4">
      <div class="container">
        <h2 class="text-center">{{ 'Les dernières élections en Belgique'|trans }}</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-5">
          {% for election in latest_elections %}
            <div class="col d-flex">
              {% include 'election/_card.html.twig' with {
                election: election
              } %}
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
    {% set i = 0 %}
    <section class="split-layout">
      <h2 class="my-5 text-center">{{ 'Toutes les élections en Belgique'|trans }}</h2>
      {% for election in all_elections %}
        {% set i = i + 1 %}
        {% include 'election/_all-elections.html.twig' with {
          election: election,
          is_odd: i is odd
        } %}
      {% endfor %}
    </section>

    <section class="elections-infos py-5">
      <div class="container">
        <div class="card bg-blur p-4 card-large">
          <h2>{{ 'Comment se déroulent les élections en Belgique'|trans }}</h2>

          <p>
            Exsistit autem hoc loco quaedam quaestio subdifficilis, num quando amici novi, digni amicitia, veteribus
            sint anteponendi, ut equis vetulis teneros anteponere solemus. Indigna homine dubitatio! Non enim debent
            esse loem ip amicitiarum sicut aliarum rerum satietates; veterrima quaeque, ut ea vina, quae vetustatem
            ferunt, esse debet lorem suavissima; verumque illu Indigna homine dubitatio! Non enim debent esse loem ip
          </p>
        </div>
      </div>
    </section>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('election') }}
{% endblock %}
