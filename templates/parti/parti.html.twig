{% extends 'layout.html.twig' %}

{% block title %}Be Elect - {{ parti.name }}{% endblock %}

{% block page_contents %}

{% if breadcrumb is defined %}
{% include 'partial/breadcrumb.html.twig' with { breadcrumb } %}
{% endif %}

<section>
    <div class="container">
        <div class="row mt-3">
            <div class="col-lg-7">
                <section>
                    <h1>{{ parti.name }}</h1>
                    <h2>{{ "Présentation détaillée" | trans }}</h2>
                    <div>{{ parti.description | raw }}</div>
                </section>

                <section class="py-3">
                    <h2>{{ "Résultats électoraux du parti" | trans }}</h2>
                    {% include 'database/index.html.twig' with {parti: parti} %}
                </section>

                <section class="bg-grey py-3 my-5">
                    <div class="container px-5">
                        <h2>{{ "Participations gouvernementales pour les différents niveaux de pouvoir" | trans }}</h2>
                        <span class="indice">{{ "Les dates non cliquables représentent les législatures pour lesquelles
                            le parti %partiName% n’était pas au gouvernement." | trans({'%partiName%' :
                            parti.name})}}</span>
                        {# // TODO LES GOUVERNEMENTS BY PARTIS #}
                        <div class="border-blue text-center p-2 m-2">
                            {% for government in governments %}
                            <img src="{{ asset('img/partis/communautaire.svg') }}" />
                            <h3>{{"Niveau %governmentType%" | trans({'%governmentType%' : government.name}) }}</h3>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            </div>
            <div class="col-lg-5">
                {% include 'parti/_wiki-resume.html.twig' with { parti, currentLeader, currentMember } %}
            </div>
        </div>
    </div>
</section>
<section>
    {% include 'parti/_resources.html.twig' with { parti } %}
</section>
<section>
    {% include 'parti/_leaders.html.twig' with { parti } %}
</section>
<section>
    {% include 'parti/_members.html.twig' with { parti } %}
</section>

{% endblock %}

{% block javascripts %}
<script>
const dataset = {{membersJson|raw}};
const labelBarChart = '{{"Nombre adhérents"|trans}}';
</script>
{{ parent() }}
{{ encore_entry_script_tags('parti') }}
{% endblock %}